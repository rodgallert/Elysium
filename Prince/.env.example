# Safe local defaults. Every published port is bound to 127.0.0.1 (this machine only); still, change the
# passwords for anything beyond your own machine, and if you ran the stack before 2026-11-14 with these values
# (ports were then open to the network), change them and recreate the volumes (docker compose down -v).
#
# The `env-check` service validates the rules written below before anything starts, and names the variable
# that breaks one.
#
# Compose reads `$` in a value as a variable reference (`Ab1$x` becomes `Ab1`, with a warning). Put a value
# that contains `$` in single quotes ('Ab1$x'), or write each `$` as `$$`.

# Postgres, published on 127.0.0.1:5432. All three must be set and must not contain a semicolon (they go into
# connection strings). The user and password are only applied when the database volume is first created.
POSTGRES_USER=prince
POSTGRES_PASSWORD=changeme
POSTGRES_DB=prince
# Host port of the reverse proxy, published on 127.0.0.1 only: http://localhost:8080/
REVERSE_PROXY_PORT=8080

# Jobs dashboard login (http://localhost:8080/jobs/). The admin account is created on the first start.
# JOBS_ADMIN_EMAIL is also the login name: only ASCII letters, digits and - . _ @ + are allowed.
# JOBS_ADMIN_PASSWORD follows ASP.NET Identity's default policy: at least 6 characters with an uppercase letter,
# a lowercase letter, a digit and a symbol (any character that is not an ASCII letter or digit). When it breaks the policy
# the account is never created and the login fails without any log line.
JOBS_ADMIN_EMAIL=admin@prince.local
JOBS_ADMIN_PASSWORD=ChangeMe123!

# Silo (file storage). The console is published on 127.0.0.1:9001; the S3 API (9000) only inside Compose.
# FILE_STORAGE_ROOT_USER: at least 3 characters. FILE_STORAGE_ROOT_PASSWORD: at least 8 characters; neither may contain a colon (the
# bucket creation passes them in a URL). Silo exits
# at startup when either is shorter. FILE_STORAGE_BUCKET follows S3 bucket names: 3 to 63 lower case letters,
# digits, dots and hyphens, starting and ending with a letter or digit, no two dots in a row, not an IP address.
FILE_STORAGE_ROOT_USER=prince-admin
FILE_STORAGE_ROOT_PASSWORD=ChangeMe123!
FILE_STORAGE_BUCKET=product-files
