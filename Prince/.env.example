# Safe local defaults. Every published port is bound to 127.0.0.1 (this machine only); still, change the
# passwords for anything beyond your own machine, and if you ran the stack before 2026-11-14 with these values
# (ports were then open to the network), change them and recreate the volumes (docker compose down -v).

# Postgres, published on 127.0.0.1:5432
POSTGRES_USER=prince
POSTGRES_PASSWORD=changeme
POSTGRES_DB=prince
# Host port of the reverse proxy, published on 127.0.0.1 only: http://localhost:8080/
REVERSE_PROXY_PORT=8080

# Jobs dashboard login (http://localhost:8080/jobs/)
JOBS_ADMIN_EMAIL=admin@prince.local
JOBS_ADMIN_PASSWORD=ChangeMe123!

# Silo (file storage). The console is published on 127.0.0.1:9001; the S3 API (9000) only inside Compose
FILE_STORAGE_ROOT_USER=prince-admin
FILE_STORAGE_ROOT_PASSWORD=ChangeMe123!
FILE_STORAGE_BUCKET=product-files
